<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="green_world">
    <!-- Luz del sol -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Plano verde -->
    <model name="grass_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <!-- Verde pasto -->
            <ambient>0.12 0.35 0.12 1</ambient>
            <diffuse>0.18 0.55 0.18 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>

