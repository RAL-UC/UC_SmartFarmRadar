<?xml version="1.0"?>
<robot name="modelo" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="pkg_share" value="$(find robot_description)"/>
  <xacro:arg name="mesh_scale" default="1 1 1"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${pkg_share}/meshes/ensamblaje_bunker.stl"
              scale="$(arg mesh_scale)"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${pkg_share}/meshes/ensamblaje_bunker.stl"
              scale="$(arg mesh_scale)"/>
      </geometry>
    </collision>
  </link>
</robot>
